    "@twograph/core": "workspace:*",
    "@twograph/editing": "workspace:*",
    "@twograph/graph": "workspace:*",
    "@twograph/indexer": "workspace:*",
    "@twograph/llm": "workspace:*",
    "@twograph/mcp": "workspace:*",
    "@twograph/rag": "workspace:*",
    "@twograph/retrieval": "workspace:*",
    "@twograph/store": "workspace:*",
    "@twograph/vector": "workspace:*",
    "commander": "^14.0.2"
  }
