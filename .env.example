# --- Datastores (docker-compose defaults) ---
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_PORT=7687
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333

# --- LLM providers (set only the ones you use; provider chosen in .twograph/config.json) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Ollama needs no key; defaults to http://localhost:11434
OLLAMA_BASE_URL=
# Free token from https://huggingface.co/settings/tokens — avoids 401s when the
# default local embedder downloads its ONNX model from Hugging Face
HF_TOKEN=

# --- TwoGraph ---
# Directory for downloaded ONNX models (UniXcoder, cross-encoder)
TWOGRAPH_MODEL_CACHE=~/.cache/twograph/models
# API server port
TWOGRAPH_PORT=4801
